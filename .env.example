# Copy to .env and fill in values. Never commit the real .env file.

# --- App ---
APP_ENV=
LOG_LEVEL=

# --- Auth (JWT, verified at the FastAPI edge) ---
# RS256: the API only ever needs the public key to verify a token. In
# prod, a real identity provider holds the private key; in dev,
# scripts/mint_dev_token.py generates and holds it (refuses to run if
# APP_ENV=production).
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=
JWT_PUBLIC_KEY_PATH=
JWT_PRIVATE_KEY_PATH=
JWT_ISSUER=
JWT_AUDIENCE=

# --- Rate limiting (in-process, per authenticated customer + global) ---
RATE_LIMIT_PER_CUSTOMER_PER_MINUTE=
RATE_LIMIT_GLOBAL_PER_MINUTE=

# --- Database (PostgreSQL + pgvector, single database) ---
# POSTGRES_USER/PASSWORD is the bootstrap owner role (used only for migrations,
# which need to CREATE ROLE / ENABLE ROW LEVEL SECURITY). The application
# connects as APP_DB_USER instead - see docs/adr and db/rls.py.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

DATABASE_MIGRATION_URL=

APP_DB_USER=
APP_DB_PASSWORD=
DATABASE_URL=

# --- Embeddings (self-hosted sentence-transformers, identical dev/prod) ---
# 384-dim to match vehicle_embeddings.embedding vector(384) - see db/models.py.
EMBEDDING_MODEL_NAME=

# --- LLM provider selection ---
# One of: groq | bedrock
LLM_PROVIDER=

# LLM per-node model routing
LLM_MODEL_CLASSIFIER=
LLM_MODEL_SYNTHESIS=

# --- Groq (local dev) ---
GROQ_API_KEY=

# --- AWS Bedrock (prod) ---
# Credentials via the standard AWS chain (env vars, shared config, or an
# ECS task role in prod) - never hardcoded, never read from these vars.
AWS_REGION=
AWS_BEDROCK_ROLE_ARN=
# Newer Claude models on Bedrock require an inference profile ID, not the
# bare model ID (on-demand throughput isn't supported for them directly)
# - use the region-prefixed profile id, e.g.
# eu.anthropic.claude-haiku-4-5-20251001-v1:0 for eu-west-1. List available
# profiles with: aws bedrock list-inference-profiles --region <region>
BEDROCK_MODEL_CLASSIFIER=
BEDROCK_MODEL_SYNTHESIS=

# --- MCP tool server ---
MCP_SERVER_HOST=
MCP_SERVER_PORT=

# --- Observability (self-hosted Langfuse) ---
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Langfuse's own Postgres (docker-compose) ---
LANGFUSE_POSTGRES_USER=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_POSTGRES_DB=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
